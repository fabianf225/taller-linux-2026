<?php

$conexion = new mysqli(
    "{{ DB_SERVER }}",
    "{{ DB_USER }}",
    "{{ DB_PASS }}",
    "{{ DB_NAME }}"
);

if ($conexion->connect_error) {
    die("Error de conexión: " . $conexion->connect_error);
}

$resultado = $conexion->query(
    "SELECT nombre, fecha FROM cumpleanios ORDER BY MONTH(fecha), DAY(fecha)"
);

if (!$resultado) {
    die("Error al consultar la base de datos");
}

echo "<h1>Lista de Cumpleaños</h1>";
echo "<table border='1'>";
echo "<tr><th>Nombre</th><th>Fecha</th></tr>";

while ($fila = $resultado->fetch_assoc()) {
    echo "<tr>";
    echo "<td>" . htmlspecialchars($fila['nombre']) . "</td>";
    echo "<td>" . htmlspecialchars($fila['fecha']) . "</td>";
    echo "</tr>";
}

echo "</table>";

$conexion->close();

?>
